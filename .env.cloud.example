# Copy to .env.cloud on the server. Replace every CHANGE_ME value before deploy.
ENVIRONMENT=demo
SITE_HOST=demo.example.com
ACME_EMAIL=you@example.com
SITE_USER=demo
# Use a Caddy bcrypt hash. Double each $ as $$ in this Compose env file.
SITE_PASSWORD_HASH=$$2a$$12$$CHANGE_ME_GENERATE_WITH_CADDY

POSTGRES_USER=eaics
POSTGRES_PASSWORD=CHANGE_ME_RANDOM_HEX
DATABASE_URL=postgresql+psycopg://eaics:${POSTGRES_PASSWORD}@postgres:5432/eaics
REDIS_URL=redis://redis:6379/0
MINIO_ROOT_USER=CHANGE_ME_MINIO_USER
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_PASSWORD
S3_ENDPOINT=http://minio:9000
S3_KEY=${MINIO_ROOT_USER}
S3_SECRET=${MINIO_ROOT_PASSWORD}

JWT_SIGNING_KEY=CHANGE_ME_RANDOM_HEX
LLM_PROVIDER=stub
LLM_MODEL=stub-1.0
LLM_API_KEY=
SYNTHETIC_SEED=42
T0_ANCHOR=2026-03-01T00:00:00Z
TEST_MODE=false
