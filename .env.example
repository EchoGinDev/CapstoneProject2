# TRD §5.7 — jangan commit .env asli. Copy dari file ini.
ENVIRONMENT=development
# Local fixed-customer sign-in is opt-in. Leave false unless all values below are explicitly configured.
DEV_CUSTOMER_AUTH_ENABLED=false
DEV_CUSTOMER_USERNAME=
DEV_CUSTOMER_PASSWORD=
DEV_CUSTOMER_ID=
DEV_TENANT_ID=
# Development-only staff allowlist. Leave disabled unless explicitly configured locally.
DEV_STAFF_AUTH_ENABLED=false
DEV_STAFF_ACCOUNTS={}
DATABASE_URL=postgresql+psycopg://eaics:eaics@localhost:5432/eaics
REDIS_URL=redis://localhost:6379/0
S3_ENDPOINT=http://localhost:9000
S3_KEY=eaics
S3_SECRET=eaics-secret-ganti-di-lokal
JWT_SIGNING_KEY=replace-with-a-random-secret-at-least-32-characters-long
JWT_ISSUER=eaics-trusted-issuer
JWT_AUDIENCE=eaics-api
# JSON map of service ID to independent random key (minimum 32 characters); never reuse JWT_SIGNING_KEY.
SERVICE_TOKEN_KEYS={"sla-beat":"ganti-kunci-random-min-32-karakter","outbox-worker":"ganti-kunci-random-min-32-karakter","orchestrator":"ganti-kunci-random-min-32-karakter"}
SERVICE_TOKEN_SCOPES={"sla-beat":["sla.read"],"outbox-worker":["sla.read"],"orchestrator":["ticket.create","ticket.read","case.create","case.read","evidence.request","sla.read","handoff.initiate","conversation.read","conversation.write","knowledge.read","tool.invoke"]}
SERVICE_TOKEN_ROLES={"sla-beat":["supervisor"],"outbox-worker":["supervisor"],"orchestrator":["ai_agent"]}
SERVICE_TENANT_ID=TNT-TEST
LLM_PROVIDER=stub
LLM_MODEL=stub-1.0
LLM_API_KEY=
# To opt in to Gemini, explicitly set LLM_PROVIDER=gemini, set LLM_MODEL to an approved model, and supply LLM_API_KEY server-side.
LLM_TIMEOUT_MS=10000
SYNTHETIC_SEED=42
T0_ANCHOR=2026-03-01T00:00:00Z
TEST_MODE=false

# Opt-in: let Gemini draft informational answers (F4 only). Falls back to the deterministic answer on any failure.
LLM_ANSWER_ENABLED=false
