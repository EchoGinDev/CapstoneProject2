# Set true only when the backend fixed-account local customer login is enabled.
VITE_ENABLE_DEV_CUSTOMER_AUTH=false
# Enable only when a server-side development staff allowlist is configured.
VITE_ENABLE_DEV_STAFF_AUTH=false
# Optional: use a same-origin development proxy by leaving this unset.
# VITE_API_BASE_URL=http://127.0.0.1:8000
